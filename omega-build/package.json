{
  "name": "omega-build",
  "version": "0.0.1",
  "private": true,
  "devDependencies": {
    "bower": "~1.8.4",
    "grunt-cli": "1.5.0",
    "grunt": "~0.4.1",
    "grunt-hub": "^0.7.0"
  },
  "scripts": {
    "deps": "pnpm install && pnpm --filter omega-web exec bower install",
