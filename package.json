{
  "name": "browser-proxy",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "build": "pnpm --filter \"@browser-proxy/*\" -r build",
    "dev": "pnpm --filter @browser-proxy/extension dev",
    "dev:firefox": "pnpm --filter @browser-proxy/extension dev:firefox",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && pnpm --filter \"@browser-proxy/*\" -r typecheck",
    "release": "pnpm build && node scripts/package-extension.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "5.0.4",
    "@types/node": "^24.0.0"
  },
  "type": "module"
}
