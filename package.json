{
  "name": "browser-proxy",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "build": "pnpm run build:modern && pnpm run build:legacy",
    "build:modern": "pnpm --filter @browser-proxy/core build",
    "build:legacy": "pnpm --filter omega-build build",
    "legacy:assets": "pnpm --filter omega-web exec bower install",
    "test": "pnpm run test:modern && pnpm run test:legacy",
    "test:modern": "vitest run",
    "test:legacy": "pnpm --filter omega-pac test && pnpm --filter omega-target test",
    "typecheck": "tsc -p tsconfig.json && pnpm --filter \"@browser-proxy/*\" -r typecheck",
    "release:legacy": "pnpm --filter omega-build release"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "5.0.4",
    "@types/node": "^24.0.0",
    "coffee-script": "1.12.7",
    "omega-pac": "workspace:*"
  },
  "type": "module"
}
